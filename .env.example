# LLM API Keys (set whichever provider you'll use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza-...
CLIPROXYAPI_API_KEY=
CLIPROXYAPI_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXYAPI_MODEL=gpt-5.5
CLIPROXYAPI_CONFIG=~/.cli-proxy-api/config.yaml
FLYINGPIG_USER_ENV=~/.flyingpig/.env

# Database
DATABASE_URL=postgresql+asyncpg://flyingpig:flyingpig@localhost:5432/flyingpig

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
LOG_LEVEL=INFO

# Agent
DEFAULT_LLM=cliproxyapi  # cliproxyapi, claude, claude-opus, openai, gemini, gemini-pro
BROWSER_HEADLESS=false
MAX_INTERACTION_MINUTES=15
RECORDINGS_DIR=recordings
