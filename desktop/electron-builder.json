{
  "appId": "ai.flyingpig.desktop",
  "productName": "Flying Pig",
  "artifactName": "Flying-Pig-${version}-${arch}-${os}.${ext}",
  "directories": {
    "output": "dist/desktop"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "lifan-builds",
      "repo": "flyingpig",
      "releaseType": "release"
    }
  ],
  "files": [
    "desktop/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist/helper",
      "to": "helper",
      "filter": [
        "**/*",
        "!**/*.log",
        "!**/*.sqlite",
        "!**/*.db",
        "!**/.env",
        "!**/recordings/**",
        "!**/logs/**",
        "!**/cookies/**"
      ]
    }
  ],
  "asar": true,
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "desktop/assets/app-icon.png",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "identity": null,
    "entitlements": "desktop/entitlements.mac.plist",
    "entitlementsInherit": "desktop/entitlements.mac.inherit.plist",
    "binaries": ["Contents/Resources/helper/flyingpig-helper"],
    "notarize": false,
    "target": ["zip"]
  },
  "win": {
    "icon": "desktop/assets/app-icon.ico",
    "target": ["nsis"]
  },
  "linux": {
    "icon": "desktop/assets/app-icon.png",
    "target": ["AppImage"]
  }
}
